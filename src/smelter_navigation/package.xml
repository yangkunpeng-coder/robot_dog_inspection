  <version>0.1.0</version>
  <description>Smelter navigation map, Nav2 parameters and RViz configuration.</description>
  <maintainer email="maintainers@example.org">Robot Dog Inspection</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>nav2_amcl</exec_depend>
